\fs36\fsmilli18080 \cf4 Det finns flera krav p\'e5 hur \'e5tg\'e4rder ska placeras och utformas i plan- och bygglagstiftningen. Dessa krav ska pr\'f6vas vid bygglov inom detaljplan.\
\pard\pardeftab720\sa320\partightenfactor0

\fs40 \cf4 Sidan v\'e4nder sig till\'a0\

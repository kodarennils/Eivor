\fs40 \cf4 Pr\'f6vning av tomtkrav i bygglov\
\pard\pardeftab720\sa480\partightenfactor0

\fs32 \cf4 Om bygglov kr\'e4vs ska kraven p\'e5 tomter pr\'f6vas i bygglovet.\
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 Plan- och bygglag (2010:900) 9 kap. 56 \'a7\cb1 \

\fs40 \cf4 Varsamhet i bebyggelsen\
\pard\pardeftab720\sa480\partightenfactor0

\fs32 \cf4 Kravet p\'e5 varsamhet g\'e4ller inte enbart enskilda byggnader utan \'e4ven hela bebyggelsemilj\'f6n. \'c4ndringar och till\'e4gg i bebyggelsen ska g\'f6ras varsamt s\'e5 att befintliga karakt\'e4rsdrag respekteras och tillvaratas.\
\pard\pardeftab720\partightenfactor0
\cf2 \cb6 Plan- och bygglag (2010:900) 2 kap. 6 \'a7\cb1 \
\pard\pardeftab720\partightenfactor0

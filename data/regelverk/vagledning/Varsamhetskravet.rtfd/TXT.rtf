\fs36\fsmilli18080 \cf4 Alla \'e4ndringar av en byggnad ska utf\'f6ras varsamt s\'e5 att man tillvaratar byggnadens v\'e4rden och kvaliteter.\
\pard\pardeftab720\sa320\partightenfactor0

\fs40 \cf4 \'c4ndringar av en byggnad ska alltid utf\'f6ras varsamt\
\pard\pardeftab720\sa480\partightenfactor0

\fs32 \cf4 \'c4ndringar av en byggnad ska enligt plan- och bygglagen (PBL) alltid utf\'f6ras varsamt. H\'e4nsyn ska tas till byggnadens karakt\'e4rsdrag och dess tekniska, historiska, kulturhistoriska, milj\'f6m\'e4ssiga och konstn\'e4rliga v\'e4rden ska tas till vara.\
\pard\pardeftab720\partightenfactor0

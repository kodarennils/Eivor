\cf4 \cb6 1 \'a7\cb1 \uc0\u8232 \cb6 \'a0\'a0En byggnad ska \cb1 \uc0\u8232 \cb6 \'a0\'a0\'a01. vara l\'e4mplig f\'f6r sitt \'e4ndam\'e5l, \cb1 \uc0\u8232 \cb6 \'a0\'a0\'a02. ha en god form-, f\'e4rg- och materialverkan, och \cb1 \uc0\u8232 \cb6 \'a0\'a0\'a03. vara tillg\'e4nglig och anv\'e4ndbar f\'f6r personer med nedsatt r\'f6relse- eller orienteringsf\'f6rm\'e5ga.\cb1 \
\pard\pardeftab720\partightenfactor0

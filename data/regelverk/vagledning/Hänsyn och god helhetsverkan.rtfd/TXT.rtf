\pard\pardeftab720\sa320\partightenfactor0
\cf4 \cb6 17 \'a7\cb1 \uc0\u8232 \cb6 \'a0\'a0\'c4ndring av en byggnad och flyttning av en byggnad ska utf\'f6ras varsamt s\'e5 att man tar h\'e4nsyn till byggnadens karakt\'e4rsdrag och tar till vara byggnadens tekniska, historiska, kulturhistoriska, milj\'f6m\'e4ssiga och konstn\'e4rliga v\'e4rden.\cb1 \
\pard\pardeftab720\partightenfactor0

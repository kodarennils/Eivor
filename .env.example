# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed server-side for privileged operations (e.g. image upload signing).
# Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key used server-side by /api/assess to run the bygglov assessment.
ANTHROPIC_API_KEY=

# Voyage AI key used to embed regelverk chunks (scripts/ingest-regelverk.mjs)
# and, later, RAG queries. Get one at https://dashboard.voyageai.com
VOYAGE_API_KEY=
